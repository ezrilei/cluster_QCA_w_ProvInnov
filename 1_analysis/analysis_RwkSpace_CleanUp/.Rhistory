# load package ----
library(dplyr)
library(ggplot2)
library(patchwork)  # 加载 patchwork
# Importing Data ----
df.Fuzzy <- readxl::read_excel(path = "./output/【Analysis_wk】1.校准_df.Fuzzy.xlsx",
sheet = 1
)
# show CN text
library(showtext) #https://github.com/yixuan/showtext
showtext_auto(enable = TRUE)
font_add('fangSong', regular = './fonts/方正仿宋_GBK.TTF') # <<<<<<<<<<<<<<
# 组间一致性调整距离：大于0.2的因果组合情况：进一步检验——必要性条件检验散点图 ----
## `Y / X3` 2016年 ----
df.Fuzzy.4_suppl <- df.Fuzzy %>%
filter(YEAR == 2016)
# 创建散点图对象，并添加从原点出发的斜对角线
p_Y_X3_2016 <- ggplot(data = df.Fuzzy.4_suppl, aes(x = X3, y = Y)) +
geom_point() +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "red") +  # y = x 线
ggtitle("情况 Y / X3（2016年）") +
xlab("X3值") +
ylab("Y值") +
xlim(range(c(df.Fuzzy.4_suppl$X3, df.Fuzzy.4_suppl$Y))) +  # 确保X轴范围与Y轴相同
ylim(range(c(df.Fuzzy.4_suppl$X3, df.Fuzzy.4_suppl$Y))) +  # 确保Y轴范围与X轴相同
theme_bw() +
theme(plot.title = element_text(hjust = 0.5),  # 标题居中
plot.margin = unit(c(0.5, 0.5, 0.5, 0.5), "cm")
)  # 调整图形的边距
p_Y_X3_2016 # 绘图
