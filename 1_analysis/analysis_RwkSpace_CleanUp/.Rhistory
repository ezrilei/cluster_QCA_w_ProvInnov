theme(
plot.margin = unit(c(0, 0, 0, 0), "cm"),
plot.tag = element_text(
size = 20,
face = "bold",
family = "SongTi"
)
) +
labs(tag = "A")
p2 <- p_case_pims_radar +
theme(
