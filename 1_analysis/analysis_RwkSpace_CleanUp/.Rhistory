# 定义参数组合（±0.10范围内扰动）
params <- list(
list(name = "Baseline", incl = 0.75, pri = 0.60, n = 2),
list(name = "InclUp1",  incl = 0.80, pri = 0.60, n = 2),
list(name = "InclUp2",  incl = 0.85, pri = 0.60, n = 2),
list(name = "InclUp3",  incl = 0.90, pri = 0.60, n = 2),
list(name = "PRIUp1",   incl = 0.75, pri = 0.65, n = 2),
list(name = "PRIUp1",   incl = 0.75, pri = 0.70, n = 2),
list(name = "PRIUp1",   incl = 0.75, pri = 0.75, n = 2),
list(name = "PRIUp1",   incl = 0.75, pri = 0.60, n = 3),
list(name = "PRIUp1",   incl = 0.75, pri = 0.65, n = 4),
list(name = "PRIUp1",   incl = 0.75, pri = 0.70, n = 5)
)
