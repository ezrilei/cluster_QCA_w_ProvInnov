font_add("SongTi", regular = "./fonts/ STSongti-Regular-SC.ttf")# <<<<<<<<<<<<<<
# text repel data
label_data <- df_cluster_data_allY_BECONS_BECOV %>%
group_by(PATHWAY) %>%
filter(YEAR == max(YEAR)) %>%
ungroup()
# store to pdf (create a pdf device) ---------------
