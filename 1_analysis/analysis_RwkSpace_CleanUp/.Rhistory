rename_with(~ paste0(.x, "→Y")) %>%
tibble::rownames_to_column(var = "CASE")
df_PIMS_negY <- intsol_negY_esa$pims %>%
rename_with(~ paste0(.x, "→~Y")) %>%
tibble::rownames_to_column(var = "CASE")
