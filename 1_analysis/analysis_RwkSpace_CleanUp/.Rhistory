plot.tag = element_text(
size = 20,
face = "bold",
family = "SongTi"
)
) +
labs(tag = "B")
# 输出到 PDF 文件
pdf(file = paste0("./output/【Analysis_wk】3.充分性分析_路径模糊集隶属度_patch（",
region_target,
"）.pdf"),
width = 14.5,
height = 7)
print(
(p1 | p2) +
plot_layout(ncol = 2,
widths = c(1, 1),
guides = "keep") &
theme(legend.position = "bottom")
)
