geom_text_repel(
family = "SongTi",
data = label_data,
aes(label = PATHWAY),
nudge_x = 0.5,             # 向右偏移
direction = "y",           # 避免上下重叠
hjust = 0,                 # 左对齐
segment.color = NA,        # 不显示连接线
size = 3.0,
box.padding = 0.3,
point.padding = 0.05,
#force = 0.6,              # 避让强度降低，避免推太远
#force_pull = 0.3,         # 吸引力增强，靠近线尾
max.overlaps = Inf,
show.legend = FALSE        # 不用其出现在图例，
# 如果不告诉其如何显示图例，会在图例处每一个config前 加默认图例项 "a"
)
print(p_config_BECONS)
dev.off()
p_config_BECONS
